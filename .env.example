# Copy to .env for local work. On Vercel, add these under Project Settings > Environment Variables.

# Contact form storage (MySQL, for example TiDB Cloud, PlanetScale or any MySQL 8 host).
# Create the table with: pnpm db:migrate
DATABASE_URL=mysql://user:password@host:3306/database?ssl={"rejectUnauthorized":true}

# Optional: where new inquiries are sent. Any URL that accepts a JSON POST
# (Slack or Discord incoming webhook, Make, Zapier ...). Works with or without the database.
INQUIRY_WEBHOOK_URL=
